<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Nossa história ❤️</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=Playfair+Display:wght@400;500&display=swap');

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    background: #f8f3ef;
    color: #493d3a;
    font-family: 'DM Sans', sans-serif;
    overflow: hidden;
}

.page {
    position: fixed;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 25px;
    text-align: center;
    animation: aparecer 0.8s ease;
}

.page.active {
    display: flex;
}

.content {
    width: 100%;
    max-width: 900px;
}

h1, h2 {
    font-family: 'Playfair Display', serif;
    font-weight: 400;
}

h1 {
    font-size: clamp(40px, 8vw, 72px);
    line-height: 1.1;
    margin-bottom: 28px;
}

h2 {
    font-size: clamp(32px, 6vw, 58px);
    line-height: 1.15;
    margin-bottom: 25px;
}

p {
    max-width: 650px;
    margin: 0 auto 22px;
    font-size: 17px;
    line-height: 1.8;
}

.heart {
    font-size: 28px;
    margin-bottom: 18px;
}

button {
    border: none;
    background: #6d5050;
    color: white;
    padding: 14px 30px;
    border-radius: 40px;
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    cursor: pointer;
    transition: 0.3s;
}

button:hover {
    transform: translateY(-2px);
}

.data {
    font-size: 14px;
    opacity: 0.6;
    margin-top: 18px;
}

.photo {
    width: min(88vw, 620px);
    height: min(67vh, 600px);
    object-fit: cover;
    border-radius: 16px;
    box-shadow: 0 15px 45px rgba(50, 35, 35, 0.18);
    margin: 20px auto;
    display: block;
}

.photo-small {
    width: min(82vw, 500px);
    height: min(48vh, 420px);
    object-fit: cover;
    border-radius: 15px;
    box-shadow: 0 12px 35px rgba(50, 35, 35, 0.15);
    margin: 20px auto;
}

.caption {
    font-family: 'Playfair Display', serif;
    font-size: clamp(23px, 4vw, 34px);
    margin: 15px auto 25px;
}

.days {
    font-family: 'Playfair Display', serif;
    font-size: clamp(60px, 12vw, 105px);
    line-height: 1;
    margin: 10px 0;
}

.final-photo {
    width: min(90vw, 700px);
    height: min(65vh, 600px);
    object-fit: cover;
    border-radius: 18px;
    box-shadow: 0 18px 50px rgba(50, 35, 35, 0.2);
    margin-bottom: 22px;
}

.final-text {
    font-family: 'Playfair Display', serif;
    font-size: clamp(25px, 5vw, 44px);
    line-height: 1.3;
}

.next {
    margin-top: 8px;
}

@keyframes aparecer {
    from {
        opacity: 0;
        transform: translateY(12px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@media (max-width: 600px) {

    .photo {
        height: 55vh;
    }

    .photo-small {
        height: 42vh;
    }

    p {
        font-size: 15px;
    }
}
</style>
</head>

<body>


<!-- 1 — ENTRADA -->

<section class="page active">
    <div class="content">

        <div class="heart">♡</div>

        <h1>
            Tenho uma coisa<br>
            pra te lembrar...
        </h1>

        <button onclick="nextPage()">
            entra aqui
        </button>

    </div>
</section>


