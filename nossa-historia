<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Uma coisa pra te lembrar ❤️</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=Playfair+Display:wght@400;500&display=swap');

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    background: #f8f3ef;
    color: #493d3a;
    font-family: 'DM Sans', sans-serif;
    overflow: hidden;
}

.page {
    min-height: 100vh;
    width: 100%;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 30px;
    text-align: center;
    animation: fade 0.8s ease;
}

.page.active {
    display: flex;
}

.content {
    width: 100%;
    max-width: 850px;
}

h1, h2 {
    font-family: 'Playfair Display', serif;
    font-weight: 400;
}

h1 {
    font-size: clamp(38px, 8vw, 70px);
    margin-bottom: 25px;
}

h2 {
    font-size: clamp(32px, 6vw, 55px);
    margin-bottom: 25px;
}

p {
    font-size: 17px;
    line-height: 1.8;
    max-width: 650px;
    margin: 0 auto 25px;
}

.small {
    font-size: 14px;
    opacity: 0.65;
}

button {
    border: none;
    background: #6e4d4d;
    color: white;
    padding: 14px 28px;
    border-radius: 30px;
    font-size: 15px;
    cursor: pointer;
    transition: 0.3s;
}

button:hover {
    transform: translateY(-2px);
    opacity: 0.9;
}

.heart {
    font-size: 24px;
    margin-bottom: 20px;
}

.photos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
    margin: 30px auto;
    max-width: 700px;
}

.photos img {
    width: 100%;
    height: 230px;
    object-fit: cover;
    border-radius: 12px;
    box-shadow: 0 8px 25px rgba(60,40,40,0.12);
}

.single-photo {
    max-width: 600px;
    margin: 30px auto;
}

.single-photo img {
    width: 100%;
    max-height: 520px;
    object-fit: cover;
    border-radius: 15px;
    box-shadow: 0 12px 35px rgba(60,40,40,0.15);
}

.days {
    font-family: 'Playfair Display', serif;
    font-size: clamp(50px, 10vw, 90px);
    margin: 15px 0;
}

.final {
    font-size: clamp(25px, 5vw, 45px);
}

.next {
    margin-top: 25px;
}

@keyframes fade {
    from {
        opacity: 0;
        transform: translateY(12px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@media (max-width: 650px) {
    .photos {
        grid-template-columns: 1fr 1fr;
    }

    .photos img {
        height: 170px;
    }

    p {
        font-size: 15px;
    }
}
</style>
</head>

<body>

<!-- TELA 1 -->
<section class="page active">
    <div class="content">
        <div class="heart">♡</div>

        <h1>Tenho uma coisa<br>pra te lembrar...</h1>

        <button onclick="nextPage()">entra aqui</button>
    </div>
</section>


<!-- TELA 2 -->
<section class="page">
    <div class="content">

        <h2>Eu amo a nossa história.</h2>

        <div class="photos">

            <!-- TROQUE PELOS NOMES DAS SUAS FOTOS -->
            <img src="foto1.jpg" alt="Nós">
            <img src="foto2.jpg" alt="Nós">
            <img src="foto3.jpg" alt="Nós">

        </div>

        <p class="small">
            21.11.2024 — <span id="days1"></span> dias de nós.
        </p>

        <button class="next" onclick="nextPage()">continuar</button>
    </div>
</section>


<!-- TELA 3 -->
<section class="page">
    <div class="content">

        <h2>Eu amo nossas fotos.</h2>

        <p>
            Amo nossas lembranças, nossas histórias e todas aquelas
            pequenas coisas que talvez só façam sentido porque foram
            vividas com você.
        </p>

        <div class="photos">

            <img src="foto4.jpg" alt="Nós">
            <img src="foto5.jpg" alt="Nós">
            <img src="foto6.jpg" alt="Nós">

        </div>

        <button class="next" onclick="nextPage()">mais uma coisa...</button>
    </div>
</section>


<!-- TELA 4 -->
<section class="page">
    <div class="content">

        <div class="heart">♡</div>

        <h2>Obrigada.</h2>

        <p>
            Obrigada por estar comigo durante todo esse tempo
            e por fazer questão de cultivar o nosso amor.
        </p>

        <p>
            Por estar nos momentos bons, nos momentos difíceis,
            nas coisas grandes e também nas pequenas.
        </p>

        <p>
            <strong>Você é uma pessoa muito importante para mim.</strong>
        </p>

        <button class="next" onclick="nextPage()">continuar</button>
    </div>
</section>


<!-- TELA 5 -->
<section class="page">
    <div class="content">

        <h2>Eu quero continuar vivendo a vida com você.</h2>

        <p>
            Fazer planos, criar memórias, conhecer lugares,
            rir das mesmas coisas e ter muitas outras histórias
            para contar.
        </p>

        <p>
            Quero continuar escolhendo você
            e a nossa história. ❤️
        </p>

        <button class="next" onclick="nextPage()">última coisa...</button>
    </div>
</section>


<!-- TELA FINAL -->
<section class="page">
    <div class="content">

        <div class="single-photo">

            <!-- COLOQUE A FOTO MAIS ESPECIAL AQUI -->
            <img src="foto-especial.jpg" alt="Nós dois">

        </div>

        <div class="days">
            <span id="days2"></span>
        </div>

        <p class="final">
            dias de nós.
        </p>

        <p>
            E eu ainda quero uma vida inteira de nós.
        </p>

        <p>
            <strong>Eu te amo. ❤️</strong>
        </p>

    </div>
</section>


<script>

let currentPage = 0;
const pages = document.querySelectorAll('.page');

function nextPage() {

    if (currentPage < pages.length - 1) {

        pages[currentPage].classList.remove('active');

        currentPage++;

        pages[currentPage].classList.add('active');
    }
}


/* CONTADOR DE DIAS */

const inicio = new Date(2024, 10, 21);

function calcularDias() {

    const hoje = new Date();

    inicio.setHours(0,0,0,0);
    hoje.setHours(0,0,0,0);

    const diferenca = hoje - inicio;

    return Math.floor(diferenca / (1000 * 60 * 60 * 24));
}

const dias = calcularDias();

document.getElementById("days1").textContent = dias;
document.getElementById("days2").textContent = dias;

</script>

</body>
</html>
